# Serve Next.js global 404 page for any path Apache cannot find.
# Required when deploying static export (out/) on Apache so global-not-found runs.
# Files in public/ are copied to out/ during "next build" with output: "export".

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
</IfModule>

# Use the app's 404 page for all "not found" responses (from global-not-found.tsx → 404.html).
# If the app is in a subdirectory (e.g. /admin/), use: ErrorDocument 404 /admin/404.html
ErrorDocument 404 /404.html
